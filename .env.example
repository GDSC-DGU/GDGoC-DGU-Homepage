# 복사해서 .env로 쓰고 값을 채웁니다. .env는 커밋 금지

# ── ai ──
GRADING_CLIENT=fake
GEMINI_BACKEND=ai_studio
# 개인 AI Studio 키. 로컬 · 가짜 데이터 전용
AI_STUDIO_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_THINKING_LEVEL=medium
GEMINI_TIMEOUT_SECONDS=90
# 경로는 ai/ 기준
GRADING_PROMPT_PATH=../scripts/seed/prompts/grading.local.yaml
# 로컬 로그 폴더. 경로는 ai/ 기준
LOG_DIR=logs
# vertex 전용
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
