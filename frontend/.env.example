# 복사해서 .env.local 로 쓰세요 (.env.local 은 git 에 올라가지 않습니다)

# mock = 예시 데이터 (기본), http = Spring Boot API
VITE_DATA_SOURCE=mock
VITE_API_BASE=/api
# 로그인 방식. google = 실제 Google 로그인 (/api/v1/auth), example = 예시 계정.
# 비우면 VITE_DATA_SOURCE 를 따른다 (http → google). 공개 데이터는 예시로 두고 로그인만 켤 때 google 로 둔다.
VITE_AUTH=
# Google 로그인 버튼 (로그인 방식이 google 일 때). Google Cloud 콘솔 > OAuth 클라이언트(웹 애플리케이션) ID.
# 공개 값이라 브라우저에 들어가도 된다 (비밀번호 · 시크릿은 넣지 않는다). 백엔드 GOOGLE_CLIENT_ID 와 같은 값.
# 그 클라이언트의 '승인된 자바스크립트 원본'에 http://localhost:5173 · https://dev.gdgoc-dgu.com · https://gdgoc-dgu.com 이 있어야 한다
VITE_GOOGLE_CLIENT_ID=
# npm run dev 에서 /api 를 넘길 Spring Boot 주소
API_PROXY_TARGET=http://localhost:8080

# browser = /projects 주소 (기본), hash = #/projects 주소 (서버 설정 없는 미리보기용)
VITE_ROUTER=browser

# true = 준비 중 페이지에 팀 기획 메모(와이어프레임 번호, 정할 것)를 보임. npm run dev 에서는 늘 보임
VITE_SHOW_PLAN=false
